+// K1's vendor encoder must finish its input queue before NULL. Otherwise it can
+// retain the camera's DMA-BUF pool for tens of seconds during a quick reconnect.
+// This runs on the existing finalizer worker, after all producer links are gone.
+// Do not wait for the pipeline bus: CustomBusStream consumes its messages.
+fn drain_spacemit_encoder(pipeline: &gst::Pipeline) {
+    let encoders: Vec<_> = pipeline
+        .children()
+        .into_iter()
+        .filter(|element| {
+            element
+                .factory()
+                .is_some_and(|f| f.name() == "spacemith264enc")
+        })
+        .collect();
+    if encoders.is_empty() {
+        return;
+    }
+    let (sent, received) = std::sync::mpsc::channel();
+    let mut probes = Vec::new();
+    for encoder in encoders {
+        if let Some(pad) = encoder.static_pad("src") {
+            let sent = sent.clone();
+            if let Some(id) = pad.add_probe(gst::PadProbeType::EVENT_DOWNSTREAM, move |_, info| {
+                if info
+                    .event()
+                    .is_some_and(|event| matches!(event.view(), gst::EventView::Eos(..)))
+                {
+                    let _ = sent.send(());
+                }
+                gst::PadProbeReturn::Ok
+            }) {
+                probes.push((pad, id));
+            }
+        }
+    }
+    for source in pipeline
+        .children()
+        .into_iter()
+        .filter_map(|e| e.downcast::<gst_app::AppSrc>().ok())
+    {
+        let _ = source.end_of_stream();
+    }
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(2);
+    let mut drained = !probes.is_empty();
+    for _ in &probes {
+        if received
+            .recv_timeout(deadline.saturating_duration_since(std::time::Instant::now()))
+            .is_err()
+        {
+            drained = false;
+            break;
+        }
+    }
+    for (pad, id) in probes {
+        pad.remove_probe(id);
+    }
+    if drained {
+        gst::info!(
+            CAT,
+            obj = pipeline,
+            "K1 encoder drained before session teardown"
+        );
+    } else {
+        gst::warning!(
+            CAT,
+            obj = pipeline,
+            "K1 encoder EOS timed out; attempting NULL"
+        );
+    }
+}
