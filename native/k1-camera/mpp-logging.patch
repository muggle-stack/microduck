diff --git a/utils/include/log.h b/utils/include/log.h
--- a/utils/include/log.h
+++ b/utils/include/log.h
@@ -19,10 +19,10 @@
 #if USE_PRINTF
-#define error(fmt, ...) printf("[MPP-ERROR] %ld:%s:%d " fmt "\n", gettid(), __FUNCTION__, __LINE__, ##__VA_ARGS__)
-#define info(fmt, ...) printf("[MPP-INFO] %ld:%s:%d " fmt "\n", gettid(), __FUNCTION__, __LINE__, ##__VA_ARGS__)
+#define error(fmt, ...) fprintf(stderr, "[MPP-ERROR] %ld:%s:%d " fmt "\n", gettid(), __FUNCTION__, __LINE__, ##__VA_ARGS__)
+#define info(fmt, ...) fprintf(stderr, "[MPP-INFO] %ld:%s:%d " fmt "\n", gettid(), __FUNCTION__, __LINE__, ##__VA_ARGS__)
 #if ENABLE_DEBUG
-#define debug(fmt, ...) printf("[MPP-DEBUG] %ld:%s:%d " fmt "\n", gettid(), __FUNCTION__, __LINE__, ##__VA_ARGS__)
-#define debug_pre(fmt, ...) printf("[MPP-DEBUG] %ld:%s:%d " fmt " ", gettid(), __FUNCTION__, __LINE__, ##__VA_ARGS__)
-#define debug_mid(fmt, ...) printf(" " fmt " ", ##__VA_ARGS__)
-#define debug_after(fmt, ...) printf(" " fmt "\n", ##__VA_ARGS__)
+#define debug(fmt, ...) fprintf(stderr, "[MPP-DEBUG] %ld:%s:%d " fmt "\n", gettid(), __FUNCTION__, __LINE__, ##__VA_ARGS__)
+#define debug_pre(fmt, ...) fprintf(stderr, "[MPP-DEBUG] %ld:%s:%d " fmt " ", gettid(), __FUNCTION__, __LINE__, ##__VA_ARGS__)
+#define debug_mid(fmt, ...) fprintf(stderr, " " fmt " ", ##__VA_ARGS__)
+#define debug_after(fmt, ...) fprintf(stderr, " " fmt "\n", ##__VA_ARGS__)
 #else
