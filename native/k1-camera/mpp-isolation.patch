-FIND_PLUGIN(V4L2_LINLONV5V7, v4l2_linlonv5v7, v4l2_linlonv5v7_codec2)
+/* The camera bundle must never load a different system/user codec ABI. */
+S32 find_v4l2_linlonv5v7_plugin(U8 *path) {
+    Dl_info self;
+    if (!dladdr((void *)&find_v4l2_linlonv5v7_plugin, &self) || !self.dli_fname)
+        return 0;
+    const char *slash = strrchr(self.dli_fname, '/');
+    if (!slash)
+        return 0;
+    int len = snprintf((char *)path, MAX_PATH_LENGTH, "%.*s/libv4l2_linlonv5v7_codec2.so",
+                       (int)(slash - self.dli_fname), self.dli_fname);
+    if (len < 0 || len >= MAX_PATH_LENGTH)
+        return 0;
+    return access((const char *)path, R_OK) == 0;
+}
 FIND_PLUGIN(K1_V2D, k1_v2d, v2d_plugin)
